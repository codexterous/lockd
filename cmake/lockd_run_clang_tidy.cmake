cmake_minimum_required(VERSION 3.24)

if (NOT LOCKD_TIDY_EXECUTABLE OR NOT EXISTS "${LOCKD_TIDY_EXECUTABLE}")
    message(FATAL_ERROR "Install clang-tidy on PATH and reload CMake, or set "
            "LOCKD_CLANG_TIDY_EXECUTABLE to its executable. No analysis was performed.")
endif ()
set(database "${LOCKD_TIDY_BUILD_DIR}/compile_commands.json")
if (NOT EXISTS "${database}")
    message(FATAL_ERROR "Missing ${database}. Configure with Ninja or Makefiles first.")
endif ()
file(READ "${database}" commands)
string(JSON count LENGTH "${commands}")
set(sources)
if (count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON source GET "${commands}" ${index} file)
        # Resource compiler entries share the database, but clang-tidy only understands
        # C and C++. In particular, MSVC's .rc commands contain incompatible /fo options.
        if (NOT source MATCHES "\\.(c|C|cc|cp|cpp|CPP|cxx|c\\+\\+)$")
            continue()
        endif ()
        cmake_path(IS_PREFIX LOCKD_TIDY_SOURCE_DIR "${source}" NORMALIZE owned)
        if (owned)
            list(APPEND sources "${source}")
        endif ()
    endforeach ()
endif ()
list(REMOVE_DUPLICATES sources)

# Native profiles can omit Python even when a wheel has already been built. Keep
# native commands and borrow only binding commands from a compatible shared build.
set(python_sources)
set(python_directory "${LOCKD_TIDY_SOURCE_DIR}/lib/pylockd")
set(has_python FALSE)
foreach(source IN LISTS sources)
    cmake_path(IS_PREFIX python_directory "${source}" NORMALIZE in_python)
    if (in_python)
        set(has_python TRUE)
    endif ()
endforeach ()
if (LOCKD_TIDY_FULL AND NOT has_python AND
        EXISTS "${LOCKD_TIDY_BUILD_DIR}/CMakeCache.txt")
    load_cache("${LOCKD_TIDY_BUILD_DIR}" READ_WITH_PREFIX native_
            LOCKD_STATIC_RUNTIME LOCKD_TARGET_ARCH CMAKE_CXX_COMPILER)
    include("${CMAKE_CURRENT_LIST_DIR}/lockd_clang_tidy_python.cmake")
    if (native_LOCKD_STATIC_RUNTIME)
        get_filename_component(python_build_dir "${LOCKD_TIDY_BUILD_DIR}/../shared" ABSOLUTE)
        lockd_python_analysis_sources("${python_build_dir}" "${LOCKD_TIDY_SOURCE_DIR}"
                "${native_LOCKD_TARGET_ARCH}" "${native_CMAKE_CXX_COMPILER}" python_sources)
    endif ()
    if (NOT python_sources)
        # scikit-build-core keeps wheel commands in ABI-specific trees. Prefer
        # the most recently configured compatible wheel if the native profile
        # lacks Boost.Python for its interpreter. Never take its embedded client.
        file(GLOB wheel_databases
                "${python_directory}/output/obj/*/opt/static/compile_commands.json"
                "${python_directory}/output/obj/*/opt/static/*/compile_commands.json")
        set(newest_database_time "")
        foreach(wheel_database IN LISTS wheel_databases)
            get_filename_component(wheel_build_dir "${wheel_database}" DIRECTORY)
            lockd_python_analysis_sources("${wheel_build_dir}" "${LOCKD_TIDY_SOURCE_DIR}"
                    "${native_LOCKD_TARGET_ARCH}" "${native_CMAKE_CXX_COMPILER}" wheel_sources)
            if (wheel_sources)
                file(TIMESTAMP "${wheel_database}" database_time "%Y%m%d%H%M%S" UTC)
                if (NOT python_sources OR database_time STRGREATER newest_database_time)
                    set(python_sources "${wheel_sources}")
                    set(python_build_dir "${wheel_build_dir}")
                    set(newest_database_time "${database_time}")
                endif ()
            endif ()
        endforeach ()
    endif ()
    if (python_sources)
        list(APPEND sources ${python_sources})
        message(STATUS "clang-tidy Python compilation database: ${python_build_dir}/compile_commands.json")
    endif ()
endif ()
if (NOT sources)
    message(FATAL_ERROR "No project translation units found in ${database}.")
endif ()

message(STATUS "clang-tidy compilation database: ${database}")
set(missing_components)
foreach(component IN ITEMS source lib/liblockd lib/liblockd_dll lib/pylockd utility/lockd_test)
    set(component_count 0)
    set(component_directory "${LOCKD_TIDY_SOURCE_DIR}/${component}")
    foreach(source IN LISTS sources)
        cmake_path(IS_PREFIX component_directory "${source}" NORMALIZE in_component)
        if (in_component)
            math(EXPR component_count "${component_count} + 1")
        endif ()
    endforeach ()
    message(STATUS "clang-tidy coverage: ${component}: ${component_count} translation unit(s)")
    if (component_count EQUAL 0)
        list(APPEND missing_components "${component}")
    endif ()
endforeach ()
if (LOCKD_TIDY_FULL AND missing_components)
    message(FATAL_ERROR "Full clang-tidy scan is missing components: ${missing_components}. "
            "Configure a native shared build with BUILD_TESTING=ON and LOCKD_BUILD_PYTHON=ON, "
            "including matching Python and Boost.Python development files, or build pylockd_wheel "
            "from a matching native profile to supply the binding commands. No analysis was performed.")
endif ()

set(arguments --quiet "-p=${LOCKD_TIDY_BUILD_DIR}"
        "--config-file=${LOCKD_TIDY_SOURCE_DIR}/.clang-tidy")
include("${CMAKE_CURRENT_LIST_DIR}/lockd_clang_tidy_arguments.cmake")
lockd_clang_tidy_arguments("${LOCKD_TIDY_EXECUTABLE}" compatibility_arguments)
message(STATUS "clang-tidy: ${LOCKD_TIDY_EXECUTABLE} (LLVM ${LOCKD_TIDY_VERSION_MAJOR})")
list(APPEND arguments ${compatibility_arguments})
if (LOCKD_TIDY_STRICT)
    list(APPEND arguments "--warnings-as-errors=*")
endif ()
if (LOCKD_TIDY_MSVC)
    list(APPEND arguments "--extra-arg-before=--driver-mode=cl")
    if (LOCKD_TIDY_POINTER_SIZE EQUAL 4)
        list(APPEND arguments "--extra-arg=--target=i686-pc-windows-msvc")
    endif ()
endif ()
include("${CMAKE_CURRENT_LIST_DIR}/lockd_clang_tidy_source.cmake")
if (NOT DEFINED LOCKD_TIDY_JOBS)
    set(LOCKD_TIDY_JOBS 1)
endif ()
if (NOT LOCKD_TIDY_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "LOCKD_TIDY_JOBS must be a positive integer.")
endif ()
if (LOCKD_TIDY_JOBS GREATER 1)
    # CTest supplies bounded scheduling and grouped diagnostics without requiring
    # Python or a second build-system generator. Rewrite the task list on every scan.
    set(scan_directory "${LOCKD_TIDY_BUILD_DIR}/clang-tidy-scan")
    set(source_runner "${CMAKE_CURRENT_LIST_DIR}/lockd_clang_tidy_source.cmake")
    file(MAKE_DIRECTORY "${scan_directory}")
    file(WRITE "${scan_directory}/CTestTestfile.cmake" "")
    set(task_index 0)
endif ()
set(failures 0)
foreach(source IN LISTS sources)
    message(STATUS "clang-tidy: ${source}")
    set(source_arguments ${arguments})
    if (source IN_LIST python_sources)
        list(REMOVE_ITEM source_arguments "-p=${LOCKD_TIDY_BUILD_DIR}")
        list(APPEND source_arguments "-p=${python_build_dir}")
    endif ()

    # CMake can omit the standard flag when GCC already defaults to C++17.
    # Supply that baseline to clang-tidy before any explicit database flags.
    if (NOT source MATCHES "\\.c$")
        if (LOCKD_TIDY_MSVC)
            list(APPEND source_arguments "--extra-arg-before=/std:c++17")
        else ()
            list(APPEND source_arguments "--extra-arg-before=-std=gnu++17")
        endif ()
    endif ()

    if (LOCKD_TIDY_JOBS GREATER 1)
        math(EXPR task_index "${task_index} + 1")
        set(task_file "${scan_directory}/${task_index}.cmake")
        file(WRITE "${task_file}.log" "")
        file(WRITE "${task_file}"
                "set(LOCKD_TIDY_EXECUTABLE [==[${LOCKD_TIDY_EXECUTABLE}]==])\n"
                "set(LOCKD_TIDY_SOURCE_DIR [==[${LOCKD_TIDY_SOURCE_DIR}]==])\n"
                "set(source [==[${source}]==])\nset(source_arguments)\n")
        foreach(argument IN LISTS source_arguments)
            file(APPEND "${task_file}" "list(APPEND source_arguments [==[${argument}]==])\n")
        endforeach ()
        file(RELATIVE_PATH task_name "${LOCKD_TIDY_SOURCE_DIR}" "${source}")
        file(APPEND "${scan_directory}/CTestTestfile.cmake"
                "add_test([==[${task_name}]==] [==[${CMAKE_COMMAND}]==] "
                "[==[-DLOCKD_TIDY_INPUT=${task_file}]==] -P [==[${source_runner}]==])\n")
        continue()
    endif ()
    lockd_analyze_source(result)
    if (NOT result STREQUAL "0")
        math(EXPR failures "${failures} + 1")
    endif ()
endforeach ()
if (failures GREATER 0)
    message(FATAL_ERROR "Clang-tidy failed for ${failures} translation unit(s).")
endif ()

if (LOCKD_TIDY_JOBS GREATER 1)
    get_filename_component(cmake_directory "${CMAKE_COMMAND}" DIRECTORY)
    set(ctest "${cmake_directory}/ctest")
    if (CMAKE_HOST_WIN32)
        string(APPEND ctest ".exe")
    endif ()
    execute_process(COMMAND "${ctest}" --test-dir "${scan_directory}"
            --parallel "${LOCKD_TIDY_JOBS}" --output-on-failure --no-tests=error
            RESULT_VARIABLE scan_result OUTPUT_VARIABLE scan_output ERROR_VARIABLE scan_errors)

    # CTest hides output from successful workers, including nonfatal findings.
    # Replay those findings without its command dumps and test bookkeeping.
    foreach(index RANGE 1 ${task_index})
        file(READ "${scan_directory}/${index}.cmake.log" diagnostics)
        if (NOT diagnostics STREQUAL "")
            message("${diagnostics}")
        endif ()
    endforeach ()
    if (NOT scan_result STREQUAL "0")
        message("${scan_output}${scan_errors}")
        message(FATAL_ERROR "Parallel clang-tidy scan failed; see diagnostics above.")
    endif ()
endif ()
