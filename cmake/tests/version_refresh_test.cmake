cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/test_helpers.cmake")
find_package(Git REQUIRED)
lockd_test_prepare()
set(upstream "${LOCKD_TEST_WORK}/upstream")
set(checkout "${LOCKD_TEST_WORK}/checkout")
set(build "${checkout}/build")
file(MAKE_DIRECTORY "${upstream}/cmake")
foreach(name IN ITEMS lockd_version.cmake lockd_build_version.hpp.in)
    configure_file("${LOCKD_TEST_SOURCE}/cmake/${name}" "${upstream}/cmake/${name}" COPYONLY)
endforeach ()
file(WRITE "${upstream}/cmake/version.txt" "1.0.1.dev0\n")
file(WRITE "${upstream}/tracked.txt" "original\n")
file(WRITE "${upstream}/.gitignore" "/build/\n")
file(WRITE "${upstream}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
include(cmake/lockd_version.cmake)
project(version_fixture VERSION ${Lockd_VERSION} LANGUAGES NONE)
configure_file(cmake/lockd_build_version.hpp.in generated/lockd_build_version.hpp @ONLY)
file(WRITE "${CMAKE_BINARY_DIR}/project_version.txt" "${PROJECT_VERSION}")
add_custom_target(check ALL COMMAND "${CMAKE_COMMAND}" -E true)
]=])

function(commit directory)
    lockd_test_run(DIRECTORY "${directory}" COMMAND "${GIT_EXECUTABLE}" add .)
    lockd_test_run(DIRECTORY "${directory}" COMMAND "${GIT_EXECUTABLE}"
            -c core.hooksPath= -c "user.name=Version test"
            -c user.email=version-test@example.invalid -c commit.gpgsign=false commit -m fixture)
endfunction()

function(configure expected)
    lockd_test_run(OUTPUT output COMMAND "${CMAKE_COMMAND}" -S "${checkout}" -B "${build}"
            -G "${LOCKD_TEST_GENERATOR}" "-DCMAKE_MAKE_PROGRAM=${LOCKD_TEST_MAKE_PROGRAM}" ${ARGN})
    file(READ "${build}/generated/lockd_build_version.hpp" header)
    string(REPLACE ".dev0" "-dev" native_version "${expected}")
    lockd_test_contains("${header}" "#define LOCKD_VERSION_STRING \"${native_version}\"")
    string(REPLACE ".dev0" "" project_version "${expected}")
    file(READ "${build}/project_version.txt" generated_version)
    lockd_test_equal("${generated_version}" "${project_version}")
    file(READ "${checkout}/cmake/version.txt" source_version)
    string(REPLACE "\r\n" "\n" source_version "${source_version}")
    lockd_test_equal("${source_version}" "1.0.1.dev0\n")
    set(configure_output "${output}" PARENT_SCOPE)
endfunction()

lockd_test_run(DIRECTORY "${upstream}" COMMAND "${GIT_EXECUTABLE}" init)
commit("${upstream}")
lockd_test_run(COMMAND "${GIT_EXECUTABLE}" clone "${upstream}" "${checkout}")
configure(1.0.1.dev0)
lockd_test_run(DIRECTORY "${upstream}" COMMAND "${GIT_EXECUTABLE}" tag build/v1.0.7)
configure(1.0.7.dev0)
file(TIMESTAMP "${build}/generated/lockd_build_version.hpp" before "%s.%f" UTC)
lockd_test_run(COMMAND "${CMAKE_COMMAND}" --build "${build}")
configure(1.0.7.dev0)
lockd_test_run(COMMAND "${CMAKE_COMMAND}" --build "${build}")
file(TIMESTAMP "${build}/generated/lockd_build_version.hpp" after "%s.%f" UTC)
lockd_test_equal("${after}" "${before}")
lockd_test_run(DIRECTORY "${checkout}" OUTPUT status
        COMMAND "${GIT_EXECUTABLE}" status --porcelain)
lockd_test_equal("${status}" "")

# Assignments from another commit cannot label this checkout. Local edits and a new
# local commit retain the latest reachable assignment rather than the remote's head.
file(WRITE "${upstream}/tracked.txt" "remote change\n")
commit("${upstream}")
lockd_test_run(DIRECTORY "${upstream}" COMMAND "${GIT_EXECUTABLE}" tag build/v1.0.8)
configure(1.0.7.dev0)
file(WRITE "${checkout}/tracked.txt" "local change\n")
configure(1.0.7.dev0)
commit("${checkout}")
configure(1.0.7.dev0)
lockd_test_run(DIRECTORY "${checkout}"
        COMMAND "${GIT_EXECUTABLE}" remote set-url origin "${LOCKD_TEST_WORK}/missing")
configure(1.0.7.dev0)
lockd_test_contains("${configure_output}" "using local assignments")
configure(1.0.7.dev0 -DLOCKD_REFRESH_VERSION=OFF)
string(FIND "${configure_output}" "refresh unavailable" warning)
lockd_test_equal("${warning}" "-1")

# Wheel metadata reads version.txt before CMake, so the backend must keep that version.
configure(1.0.1.dev0 -DSKBUILD=ON)
