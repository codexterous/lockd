cmake_minimum_required(VERSION 3.24)
include("${LOCKD_LAYOUT_MANIFEST}")

# Check the generated compiler and linker paths, rather than only the helper's
# calculations. A target accidentally declared at the root must fail this test.
foreach(target IN LISTS layout_targets)
    set(component "${layout_component_${target}}")
    if (layout_wheel)
        set(object_root "${layout_build}/")
        set(artifact_root "${layout_build}/")
    else ()
        if (component STREQUAL ".")
            set(output_root "${layout_output}")
            set(object_root "${layout_build}/")
        else ()
            if (layout_output STREQUAL "${layout_source}/output")
                set(output_root "${layout_source}/${component}/output")
            else ()
                set(output_root "${layout_output}/${component}/output")
            endif ()
            set(object_root
                    "${output_root}/obj/${layout_arch}/${layout_profile}/${layout_linkage}/")
        endif ()
        if (target STREQUAL "lockd_daemon_core")
            set(artifact_root "${layout_build}/")
        else ()
            set(artifact_root
                    "${output_root}/${layout_arch}/${layout_profile}/${layout_linkage}/")
        endif ()
    endif ()
    foreach(object IN LISTS layout_objects_${target})
        string(FIND "${object}" "${object_root}" position)
        if (NOT position EQUAL 0)
            message(FATAL_ERROR "${target} object outside ${object_root}: ${object}")
        endif ()
    endforeach ()
    string(FIND "${layout_file_${target}}" "${artifact_root}" position)
    if (NOT position EQUAL 0)
        message(FATAL_ERROR
                "${target} deliverable outside ${artifact_root}: ${layout_file_${target}}")
    endif ()
    if (DEFINED layout_pdb_${target})
        string(FIND "${layout_pdb_${target}}" "${artifact_root}" position)
        if (NOT position EQUAL 0)
            message(FATAL_ERROR
                    "${target} debug symbols outside ${artifact_root}: ${layout_pdb_${target}}")
        endif ()
    endif ()
endforeach ()
