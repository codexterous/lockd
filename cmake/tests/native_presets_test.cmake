cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/test_helpers.cmake")
file(READ "${LOCKD_TEST_SOURCE}/CMakePresets.json" presets)

function(named_preset kind name result)
    string(JSON count LENGTH "${presets}" "${kind}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON selected GET "${presets}" "${kind}" ${index} name)
        if (selected STREQUAL name)
            string(JSON value GET "${presets}" "${kind}" ${index})
            set(${result} "${value}" PARENT_SCOPE)
            return()
        endif ()
    endforeach ()
    message(FATAL_ERROR "Missing ${kind} entry: ${name}")
endfunction()

set(architectures x86 x86_64 arm64)
set(compilers Win32 x64 ARM64)
set(profiles dbg opt)
set(build_types Debug Release)
foreach(architecture compiler IN ZIP_LISTS architectures compilers)
    foreach(profile build_type IN ZIP_LISTS profiles build_types)
        foreach(linkage IN ITEMS static shared)
            set(name "${architecture}-${profile}-${linkage}")
            named_preset(configurePresets "${name}" preset)
            named_preset(testPresets "${name}" test)
            string(JSON actual GET "${preset}" architecture value)
            lockd_test_equal("${actual}" "${compiler}")
            string(JSON actual GET "${preset}" architecture strategy)
            lockd_test_equal("${actual}" external)
            string(JSON actual GET "${preset}" cacheVariables LOCKD_TARGET_ARCH)
            lockd_test_equal("${actual}" "${architecture}")
            string(JSON actual GET "${preset}" cacheVariables CMAKE_BUILD_TYPE)
            lockd_test_equal("${actual}" "${build_type}")
            string(JSON actual GET "${preset}" cacheVariables LOCKD_STATIC_RUNTIME)
            if (linkage STREQUAL static)
                lockd_test_equal("${actual}" ON)
            else ()
                lockd_test_equal("${actual}" OFF)
            endif ()
            string(JSON actual GET "${preset}" cacheVariables BUILD_SHARED_LIBS)
            if (linkage STREQUAL shared)
                lockd_test_equal("${actual}" ON)
            else ()
                lockd_test_equal("${actual}" OFF)
            endif ()
            string(JSON actual GET "${preset}" binaryDir)
            lockd_test_equal("${actual}" "\${sourceDir}/output/obj/${architecture}/${profile}/${linkage}")
            string(JSON actual GET "${test}" configurePreset)
            lockd_test_equal("${actual}" "${name}")
        endforeach ()
    endforeach ()
endforeach ()
