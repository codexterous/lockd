cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/test_helpers.cmake")
lockd_test_prepare()
set(ENV{LOCKD_HOST_BUILD_DIR} "")
set(driver "${LOCKD_TEST_WORK}/settings.cmake")

# Replace the registry boundary only. Selection and path comparison use the real module.
file(WRITE "${driver}" [=[
set(CMAKE_HOST_WIN32 TRUE)
function(cmake_host_system_information)
    cmake_parse_arguments(reg "" "RESULT;QUERY;VALUE;VIEW;ERROR_VARIABLE" "" ${ARGN})
    if (NOT reg_QUERY STREQUAL "WINDOWS_REGISTRY" OR
            NOT reg_VALUE STREQUAL LOCKD_TEST_SETTING OR NOT reg_VIEW STREQUAL "HOST")
        message(FATAL_ERROR "Unexpected registry request: ${ARGN}")
    endif ()
    if (reg_UNPARSED_ARGUMENTS STREQUAL "HKCU/Environment")
        set(value "$ENV{LOCKD_TEST_USER_SETTING}")
    elseif (reg_UNPARSED_ARGUMENTS STREQUAL
            "HKLM/SYSTEM/CurrentControlSet/Control/Session Manager/Environment")
        set(value "$ENV{LOCKD_TEST_SYSTEM_SETTING}")
    else ()
        message(FATAL_ERROR "Unexpected registry key")
    endif ()
    set(${reg_RESULT} "${value}" PARENT_SCOPE)
    set(${reg_ERROR_VARIABLE} "" PARENT_SCOPE)
endfunction()
include("${LOCKD_TEST_SOURCE}/cmake/lockd_vcpkg_settings.cmake")
if (LOCKD_TEST_SETTING STREQUAL "VCPKG_ROOT")
    lockd_select_vcpkg_root(selected)
else ()
    lockd_select_vcpkg_install_options(selected)
endif ()
file(WRITE "${CMAKE_CURRENT_LIST_DIR}/selected.txt" "${selected}")
]=])
set(user "--x-buildtrees-root=X:/user build;--no-downloads")
set(system "--x-buildtrees-root=X:/system")
set(process "--x-buildtrees-root=X:/process")
foreach(case RANGE 0 5)
    unset(ENV{VCPKG_INSTALL_OPTIONS})
    set(ENV{LOCKD_TEST_USER_SETTING} "${user}")
    set(ENV{LOCKD_TEST_SYSTEM_SETTING} "${system}")
    set(expected "${user}")
    if (case EQUAL 0)
        set(ENV{LOCKD_TEST_USER_SETTING} "")
        set(ENV{LOCKD_TEST_SYSTEM_SETTING} "")
        set(expected "")
    elseif (case EQUAL 2)
        set(ENV{LOCKD_TEST_USER_SETTING} "")
        set(expected "${system}")
    elseif (case GREATER_EQUAL 3)
        set(ENV{VCPKG_INSTALL_OPTIONS} "${process}")
        set(expected "${process}")
    endif ()
    if (case GREATER_EQUAL 4)
        if (case EQUAL 4)
            set(expected --no-downloads)
        else ()
            set(expected "")
        endif ()
        lockd_test_run(COMMAND "${CMAKE_COMMAND}" "-DVCPKG_INSTALL_OPTIONS=${expected}"
                "-DLOCKD_TEST_SOURCE=${LOCKD_TEST_SOURCE}"
                -DLOCKD_TEST_SETTING=VCPKG_INSTALL_OPTIONS -P "${driver}")
    else ()
        lockd_test_run(COMMAND "${CMAKE_COMMAND}" "-DLOCKD_TEST_SOURCE=${LOCKD_TEST_SOURCE}"
                -DLOCKD_TEST_SETTING=VCPKG_INSTALL_OPTIONS -P "${driver}")
    endif ()
    file(READ "${LOCKD_TEST_WORK}/selected.txt" selected)
    lockd_test_equal("${selected}" "${expected}")
endforeach ()

set(bundled "${LOCKD_TEST_WORK}/visual-studio/VC/vcpkg")
set(configured "${LOCKD_TEST_WORK}/user-vcpkg")
set(system "${LOCKD_TEST_WORK}/system-vcpkg")
set(process "${LOCKD_TEST_WORK}/process-vcpkg")
set(explicit "${LOCKD_TEST_WORK}/explicit-vcpkg")
file(MAKE_DIRECTORY "${bundled}" "${configured}" "${system}" "${process}" "${explicit}")
set(ENV{VSINSTALLDIR} "${LOCKD_TEST_WORK}/visual-studio")
foreach(case IN ITEMS user system bundled process cmake new-environment)
    set(override "")
    set(ENV{VCPKG_ROOT} "${bundled}")
    set(ENV{LOCKD_TEST_USER_SETTING} "${configured}")
    set(ENV{LOCKD_TEST_SYSTEM_SETTING} "${system}")
    set(expected "${configured}")
    if (case STREQUAL system)
        set(ENV{LOCKD_TEST_USER_SETTING} "")
        set(expected "${system}")
    elseif (case STREQUAL bundled)
        set(ENV{LOCKD_TEST_USER_SETTING} "")
        set(ENV{LOCKD_TEST_SYSTEM_SETTING} "")
        set(expected "${bundled}")
    elseif (case STREQUAL process)
        set(ENV{VCPKG_ROOT} "${process}")
        set(expected "${process}")
    elseif (case STREQUAL cmake)
        set(override "${explicit}")
        set(expected "${explicit}")
    elseif (case STREQUAL new-environment)
        set(ENV{VCPKG_ROOT} "")
    endif ()
    lockd_test_run(COMMAND "${CMAKE_COMMAND}" "-DLOCKD_TEST_SOURCE=${LOCKD_TEST_SOURCE}"
            "-DLOCKD_VCPKG_ROOT=${override}" -DLOCKD_TEST_SETTING=VCPKG_ROOT -P "${driver}")
    file(READ "${LOCKD_TEST_WORK}/selected.txt" selected)
    lockd_test_equal("${selected}" "${expected}")
endforeach ()

# A private backend records the production wrapper's inputs without running vcpkg.
set(storage "${LOCKD_TEST_WORK}/storage")
set(checkout "${storage}/user-vcpkg")
file(MAKE_DIRECTORY "${checkout}/scripts/buildsystems")
set(settings VCPKG_ROOT VCPKG_DOWNLOADS VCPKG_DEFAULT_BINARY_CACHE
        VCPKG_BINARY_SOURCES X_VCPKG_REGISTRIES_CACHE VCPKG_DISABLE_METRICS)
# Leave environment references for the child to evaluate, not the test driver.
set(backend [=[
foreach(name IN ITEMS VCPKG_ROOT VCPKG_DOWNLOADS VCPKG_DEFAULT_BINARY_CACHE
        VCPKG_BINARY_SOURCES X_VCPKG_REGISTRIES_CACHE VCPKG_DISABLE_METRICS)
    file(APPEND "${CMAKE_BINARY_DIR}/selected.txt" "${name}=$ENV{${name}}\n")
endforeach ()
file(APPEND "${CMAKE_BINARY_DIR}/selected.txt"
        "mode=${VCPKG_MANIFEST_MODE}\ninstalled=${VCPKG_INSTALLED_DIR}\n"
        "options=${VCPKG_INSTALL_OPTIONS}\ntriplet=${VCPKG_TARGET_TRIPLET}\n")
]=])
file(WRITE "${checkout}/scripts/buildsystems/vcpkg.cmake" "${backend}")
file(WRITE "${storage}/driver.cmake"
        "include(\"${LOCKD_TEST_SOURCE}/cmake/lockd_toolchain.cmake\")\n")
foreach(name IN LISTS settings)
    set(ENV{${name}} "user-${name}")
endforeach ()
set(ENV{VCPKG_ROOT} "${checkout}")
set(ENV{VCPKG_INSTALL_OPTIONS} "--x-buildtrees-root=user-builds")
foreach(mode IN ITEMS ON OFF unset)
    if (mode STREQUAL unset)
        foreach(name IN LISTS settings)
            unset(ENV{${name}})
        endforeach ()
        set(ENV{VCPKG_ROOT} "${checkout}")
        set(expected_mode "")
        set(mode_option "")
    else ()
        set(expected_mode "${mode}")
        set(mode_option "-DVCPKG_MANIFEST_MODE=${mode}")
    endif ()
    lockd_test_run(DIRECTORY "${storage}" COMMAND "${CMAKE_COMMAND}" ${mode_option}
            -DVCPKG_INSTALLED_DIR=user-installation -DVCPKG_TARGET_TRIPLET=user-triplet
            -P "${storage}/driver.cmake")
    file(READ "${storage}/selected.txt" selected)
    foreach(name IN LISTS settings)
        lockd_test_contains("${selected}" "${name}=$ENV{${name}}\n")
    endforeach ()
    lockd_test_contains("${selected}" "mode=${expected_mode}\n")
    lockd_test_contains("${selected}" "installed=user-installation\n")
    lockd_test_contains("${selected}" "options=--x-buildtrees-root=user-builds\n")
    lockd_test_contains("${selected}" "triplet=user-triplet\n")
    file(REMOVE "${storage}/selected.txt")
endforeach ()
if (EXISTS "${storage}/output")
    message(FATAL_ERROR "The wrapper created an unrequested project storage directory")
endif ()
lockd_test_run(FAILS OUTPUT output DIRECTORY "${storage}" COMMAND "${CMAKE_COMMAND}"
        "-DLOCKD_VCPKG_ROOT=${storage}/not-installed" -P "${storage}/driver.cmake")
lockd_test_contains("${output}" "Select an existing vcpkg installation")
if (EXISTS "${storage}/not-installed" OR EXISTS "${storage}/output")
    message(FATAL_ERROR "Missing vcpkg must not clone or create another package manager")
endif ()
