cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/test_helpers.cmake")
lockd_test_prepare()

foreach(case IN ITEMS matching mismatch missing-debug other-architecture)
    set(root "${LOCKD_TEST_WORK}/${case}")
    file(MAKE_DIRECTORY "${root}/cmake" "${root}/native/boost")
    foreach(name IN ITEMS lockd_boost.cmake lockd_output_layout.cmake)
        configure_file("${LOCKD_TEST_SOURCE}/cmake/${name}" "${root}/cmake/${name}" COPYONLY)
    endforeach ()
    file(WRITE "${root}/native/boost/version.hpp" "#define BOOST_VERSION 108800\n")
    set(prefix "${root}/output/obj/${LOCKD_TEST_HOST_ARCH}/opt/shared/dependencies/release/boost_python314")
    file(MAKE_DIRECTORY "${prefix}/include/boost-1_88/boost" "${prefix}/lib/cmake/boost_python-1.88.0")
    if (case STREQUAL mismatch)
        set(version 108200)
    else ()
        set(version 108800)
    endif ()
    file(WRITE "${prefix}/include/boost-1_88/boost/version.hpp" "#define BOOST_VERSION ${version}\n")
    file(WRITE "${prefix}/lib/cmake/boost_python-1.88.0/boost_python-config-version.cmake" [=[
set(PACKAGE_VERSION 1.88.0)
set(PACKAGE_VERSION_EXACT TRUE)
set(PACKAGE_VERSION_COMPATIBLE TRUE)
]=])
    file(WRITE "${prefix}/lib/cmake/boost_python-1.88.0/boost_python-config.cmake" [=[
add_library(Boost::python SHARED IMPORTED GLOBAL)
set_target_properties(Boost::python PROPERTIES
        IMPORTED_IMPLIB_RELEASE "${CMAKE_CURRENT_LIST_DIR}/../../python.lib"
        IMPORTED_IMPLIB_DEBUG "${CMAKE_CURRENT_LIST_DIR}/../../python-d.lib")
]=])
    file(WRITE "${prefix}/lib/python.lib" "")
    if (NOT case STREQUAL missing-debug)
        file(WRITE "${prefix}/lib/python-d.lib" "")
    endif ()
    file(WRITE "${root}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(native_python NONE)
set(WIN32 TRUE)
set(MSVC TRUE)
set(Python3_VERSION_MAJOR 3)
set(Python3_VERSION_MINOR 14)
set(Lockd_BOOST_PYTHON_COMPONENT python314)
add_library(Boost::headers INTERFACE IMPORTED GLOBAL)
set_target_properties(Boost::headers PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_CURRENT_SOURCE_DIR}/native")
include(cmake/lockd_boost.cmake)
lockd_probe_cached_python(found)
if (NOT "${found}" STREQUAL "${EXPECTED}")
    message(FATAL_ERROR "Unexpected Python discovery: ${found}")
endif ()
if (found AND NOT TARGET Boost::python314)
    message(FATAL_ERROR "Missing interpreter-specific target")
endif ()
get_target_property(headers Boost::headers INTERFACE_INCLUDE_DIRECTORIES)
if (NOT headers STREQUAL "${CMAKE_CURRENT_SOURCE_DIR}/native")
    message(FATAL_ERROR "Native Boost headers changed")
endif ()
]=])
    foreach(configuration IN ITEMS Release Debug)
        set(expected TRUE)
        set(arch x86_64)
        if (case STREQUAL mismatch OR (case STREQUAL missing-debug AND configuration STREQUAL Debug))
            set(expected FALSE)
        elseif (case STREQUAL other-architecture)
            set(expected FALSE)
            set(arch x86)
        endif ()
        lockd_test_run(COMMAND "${CMAKE_COMMAND}" -E env LOCKD_HOST_BUILD_DIR=
                "${CMAKE_COMMAND}" -S "${root}" -B "${root}/build-${configuration}-${arch}"
                -G "${LOCKD_TEST_GENERATOR}" "-DCMAKE_MAKE_PROGRAM=${LOCKD_TEST_MAKE_PROGRAM}"
                "-DEXPECTED=${expected}" "-DCMAKE_BUILD_TYPE=${configuration}" "-DLockd_ARCH=${arch}")
    endforeach ()
endforeach ()
