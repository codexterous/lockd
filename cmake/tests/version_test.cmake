cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/test_helpers.cmake")
lockd_test_prepare()
foreach(name IN ITEMS lockd_version.cmake lockd_build_version.hpp.in)
    configure_file("${LOCKD_TEST_SOURCE}/cmake/${name}" "${LOCKD_TEST_WORK}/${name}" COPYONLY)
endforeach ()
file(WRITE "${LOCKD_TEST_WORK}/check.cmake" [=[
cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/lockd_version.cmake")
configure_file("${CMAKE_CURRENT_LIST_DIR}/lockd_build_version.hpp.in"
        "${CMAKE_CURRENT_LIST_DIR}/version.hpp" @ONLY)
]=])
foreach(version IN ITEMS 1.0.1.dev0 1.0.99 1.1.0 1.1.0 1.0.100 01.0.1)
    file(WRITE "${LOCKD_TEST_WORK}/version.txt" "${version}\n")
    if (version STREQUAL "1.0.100" OR version STREQUAL "01.0.1")
        lockd_test_run(FAILS COMMAND "${CMAKE_COMMAND}" -P "${LOCKD_TEST_WORK}/check.cmake")
    else ()
        lockd_test_run(COMMAND "${CMAKE_COMMAND}" -P "${LOCKD_TEST_WORK}/check.cmake")
        file(READ "${LOCKD_TEST_WORK}/version.hpp" header)
        string(REPLACE ".dev0" "-dev" native_version "${version}")
        lockd_test_contains("${header}" "#define LOCKD_VERSION_STRING \"${native_version}\"")
        string(REPLACE "." ";" fields "${version}")
        list(GET fields 2 number)
        lockd_test_contains("${header}" "#define BUILD_NUMBER ${number}\n")
    endif ()
endforeach ()
