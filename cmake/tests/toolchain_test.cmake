cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/test_helpers.cmake")
lockd_test_prepare()
set(ENV{LOCKD_HOST_BUILD_DIR} "")
set(configure "${CMAKE_COMMAND}" -G "${LOCKD_TEST_GENERATOR}"
        "-DCMAKE_MAKE_PROGRAM=${LOCKD_TEST_MAKE_PROGRAM}")

# A multi-configuration generator must fail before dependency setup is reached.
set(guard "${LOCKD_TEST_WORK}/generator")
file(MAKE_DIRECTORY "${guard}")
file(WRITE "${guard}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
include("${LOCKD_TEST_SOURCE}/cmake/lockd_build_options.cmake")
project(layout_rejection NONE)
message(FATAL_ERROR "Dependency_setup_reached")
]=])
lockd_test_run(FAILS OUTPUT output COMMAND "${CMAKE_COMMAND}"
        -S "${guard}" -B "${guard}/build" -G "Ninja Multi-Config"
        "-DLOCKD_TEST_SOURCE=${LOCKD_TEST_SOURCE}")
lockd_test_contains("${output}" "Use a single-configuration generator")
lockd_test_absent("${output}" "Dependency_setup_reached")

if (WIN32)
    # Keep vcpkg's real default installation policy. Only its external backend is a fixture.
    set(native "${LOCKD_TEST_WORK}/native")
    file(MAKE_DIRECTORY "${native}/cmake")
    foreach(name IN ITEMS lockd_architecture.cmake lockd_build_options.cmake
            lockd_output_layout.cmake lockd_toolchain.cmake lockd_vcpkg_settings.cmake)
        configure_file("${LOCKD_TEST_SOURCE}/cmake/${name}" "${native}/cmake/${name}" COPYONLY)
    endforeach ()
    set(backend "${native}/user-vcpkg/scripts/buildsystems")
    file(MAKE_DIRECTORY "${backend}")
    file(WRITE "${backend}/vcpkg.cmake" [=[
option(VCPKG_MANIFEST_MODE "Use manifests" ON)
option(VCPKG_MANIFEST_INSTALL "Install dependencies" ON)
if (VCPKG_MANIFEST_MODE AND VCPKG_MANIFEST_INSTALL)
    file(WRITE "${CMAKE_BINARY_DIR}/installation-enabled" "yes")
endif ()
]=])
    file(WRITE "${native}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
include(cmake/lockd_build_options.cmake NO_POLICY_SCOPE)
project(native_dependencies NONE)
]=])
    foreach(mode IN ITEMS default ON OFF)
        set(options "")
        set(expected_mode ON)
        if (NOT mode STREQUAL default)
            set(options "-DVCPKG_MANIFEST_MODE=${mode}")
            set(expected_mode "${mode}")
        endif ()
        set(build "${native}/build-${mode}")
        foreach(attempt RANGE 1 2)
            lockd_test_run(COMMAND "${CMAKE_COMMAND}" -E env "VCPKG_ROOT=${native}/user-vcpkg"
                    ${configure} -S "${native}" -B "${build}" ${options})
            if ((mode STREQUAL OFF AND EXISTS "${build}/installation-enabled") OR
                    (NOT mode STREQUAL OFF AND NOT EXISTS "${build}/installation-enabled"))
                message(FATAL_ERROR "Automatic installation policy changed in ${mode} mode")
            endif ()
            file(READ "${build}/CMakeCache.txt" cache)
            lockd_test_contains("${cache}" "LOCKD_DEPENDENCY_PROVIDER:STRING=AUTO")
            lockd_test_contains("${cache}" "VCPKG_MANIFEST_MODE:BOOL=${expected_mode}")
            lockd_test_absent("${cache}" "VCPKG_INSTALLED_DIR:")
            lockd_test_absent("${cache}" "LOCKD_VCPKG_ROOT:")
        endforeach ()
    endforeach ()
endif ()

# Nested release profiles share the outer host tree, with separate mutable probes.
set(host "${LOCKD_TEST_WORK}/analysis/output/obj/x86_64/opt/shared")
set(source "${host}/source/lockd-test")
file(MAKE_DIRECTORY "${source}/cmake")
foreach(name IN ITEMS lockd_clang_tidy.cmake lockd_output_layout.cmake)
    configure_file("${LOCKD_TEST_SOURCE}/cmake/${name}" "${source}/cmake/${name}" COPYONLY)
endforeach ()
file(WRITE "${source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(analysis_paths NONE)
enable_testing()
set(BUILD_TESTING ON)
include(cmake/lockd_clang_tidy.cmake)
lockd_configure_clang_tidy()
]=])
set(selected "")
foreach(profile IN ITEMS static shared)
    set(build "${source}/output/obj/x86_64/opt/${profile}")
    lockd_test_run(COMMAND "${CMAKE_COMMAND}" -E env "LOCKD_HOST_BUILD_DIR=${host}"
            ${configure} -S "${source}" -B "${build}" -DCMAKE_BUILD_TYPE=Release
            "-DLOCKD_CLANG_TIDY_EXECUTABLE=${CMAKE_COMMAND}")
    file(READ "${build}/CTestTestfile.cmake" tests)
    string(REGEX MATCHALL "-DLOCKD_TIDY_TEST_DIR=[^\"\n]+" directories "${tests}")
    list(LENGTH directories count)
    lockd_test_equal("${count}" "2")
    list(GET directories 0 first)
    list(GET directories 1 second)
    lockd_test_equal("${first}" "${second}")
    string(REPLACE "-DLOCKD_TIDY_TEST_DIR=" "" directory "${first}")
    cmake_path(GET directory PARENT_PATH parent)
    lockd_test_equal("${parent}" "${host}/verifications/clang_tidy")
    cmake_path(IS_PREFIX source "${directory}" NORMALIZE inside)
    if (inside)
        message(FATAL_ERROR "An extracted source tree owns its compiler probes")
    endif ()
    list(APPEND selected "${directory}")
endforeach ()
list(REMOVE_DUPLICATES selected)
list(LENGTH selected count)
lockd_test_equal("${count}" "2")

# The Python output-layout tests check their implementation against the same contract.
set(host "${LOCKD_TEST_WORK}/layout/output/obj/x86_64/opt/shared")
set(source "${host}/source/lockd-test")
file(MAKE_DIRECTORY "${source}/cmake")
configure_file("${LOCKD_TEST_SOURCE}/cmake/lockd_output_layout.cmake"
        "${source}/cmake/lockd_output_layout.cmake" COPYONLY)
file(WRITE "${source}/layout.cmake" [=[
include("${CMAKE_CURRENT_LIST_DIR}/cmake/lockd_output_layout.cmake")
file(WRITE "${CMAKE_CURRENT_LIST_DIR}/selected.txt" "${Lockd_HOST_BUILD_DIR}")
]=])
foreach(shared IN ITEMS FALSE TRUE)
    if (shared)
        set(expected "${host}")
        set(environment "${host}")
    else ()
        set(expected "${source}/output/obj/${LOCKD_TEST_HOST_ARCH}/opt/shared")
        set(environment "")
    endif ()
    foreach(attempt RANGE 1 2)
        lockd_test_run(COMMAND "${CMAKE_COMMAND}" -E env "LOCKD_HOST_BUILD_DIR=${environment}"
                "${CMAKE_COMMAND}" -P "${source}/layout.cmake")
        file(READ "${source}/selected.txt" actual)
        lockd_test_equal("${actual}" "${expected}")
    endforeach ()
endforeach ()

# Fail in the selected package header, even when working system Boost headers exist.
# The production probe must retain compiler diagnostics and explain disabled installs.
set(uuid "${LOCKD_TEST_WORK}/uuid")
file(MAKE_DIRECTORY "${uuid}/headers/boost/uuid")
file(WRITE "${uuid}/headers/boost/uuid/random_generator.hpp" "#error Broken_UUID_fixture\n")
file(WRITE "${uuid}/headers/boost/uuid/uuid.hpp" "")
file(WRITE "${uuid}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(uuid_probe CXX)
add_library(Boost::headers INTERFACE IMPORTED)
set_target_properties(Boost::headers PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_CURRENT_LIST_DIR}/headers")
include("${LOCKD_TEST_SOURCE}/cmake/lockd_boost.cmake")
lockd_check_uuid()
]=])
foreach(case IN ITEMS blocked enabled classic)
    set(mode ON)
    set(install OFF)
    if (case STREQUAL enabled)
        set(install ON)
    elseif (case STREQUAL classic)
        set(mode OFF)
    endif ()
    lockd_test_run(FAILS OUTPUT output COMMAND ${configure} -S "${uuid}" -B "${uuid}/build"
            "-DCMAKE_CXX_COMPILER=${LOCKD_TEST_CXX_COMPILER}"
            "-DLOCKD_TEST_SOURCE=${LOCKD_TEST_SOURCE}"
            "-DVCPKG_MANIFEST_MODE=${mode}" "-DVCPKG_MANIFEST_INSTALL=${install}")
    lockd_test_contains("${output}" "Broken_UUID_fixture")
    if (case STREQUAL blocked)
        lockd_test_contains("${output}" "VCPKG_MANIFEST_INSTALL=OFF")
    else ()
        lockd_test_absent("${output}" "VCPKG_MANIFEST_INSTALL=OFF")
    endif ()
endforeach ()
