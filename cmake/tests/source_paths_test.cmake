cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/test_helpers.cmake")

lockd_test_prepare()
set(source "${LOCKD_TEST_WORK}/source space 福")
set(build "${LOCKD_TEST_WORK}/build")
set(include "${source}/lib/liblockd/include")
set(sdk "${LOCKD_TEST_WORK}/sdk/include")
file(COPY "${LOCKD_TEST_SOURCE}/utility/lockd_test/tests/source_paths/" DESTINATION "${source}")
foreach(directory IN ITEMS "${include}" "${sdk}")
    file(MAKE_DIRECTORY "${directory}/liblockd/detail")
    configure_file("${LOCKD_TEST_SOURCE}/lib/liblockd/include/liblockd/exceptions.hpp"
            "${directory}/liblockd/exceptions.hpp" COPYONLY)
    configure_file("${LOCKD_TEST_SOURCE}/lib/liblockd/include/liblockd/detail/source_path.hpp"
            "${directory}/liblockd/detail/source_path.hpp" COPYONLY)
endforeach ()
configure_file("${LOCKD_TEST_SOURCE}/utility/lockd_test/include/source_path_fixture.hpp"
        "${source}/include/source_path_fixture.hpp" COPYONLY)
configure_file("${LOCKD_TEST_SOURCE}/utility/lockd_test/source/source_path_fixture.cpp"
        "${source}/nested/extra.cpp" COPYONLY)
configure_file("${LOCKD_TEST_SOURCE}/utility/lockd_test/include/source_path_fixture.hpp"
        "${sdk}/liblockd/example.hpp" COPYONLY)

set(configure "${CMAKE_COMMAND}" -S "${source}" -B "${build}"
        -G "${LOCKD_TEST_GENERATOR}" "-DCMAKE_MAKE_PROGRAM=${LOCKD_TEST_MAKE_PROGRAM}"
        "-DCMAKE_CXX_COMPILER=${LOCKD_TEST_CXX_COMPILER}"
        "-DLOCKD_INCLUDE_DIR=${include}" "-DLOCKD_SDK_INCLUDE_DIR=${sdk}")
if (WIN32)
    set(suffix .exe)
else ()
    set(suffix "")
endif ()
set(mappings ordinary)
if (LOCKD_TEST_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
    list(APPEND mappings mapped)
endif ()
foreach(mapping IN LISTS mappings)
    if (mapping STREQUAL mapped)
        set(prefix_map ON)
    else ()
        set(prefix_map OFF)
    endif ()
    foreach(configuration IN ITEMS Debug Release)
        set(settings ${configure} "-DCMAKE_BUILD_TYPE=${configuration}"
                "-DLOCKD_TEST_PREFIX_MAP=${prefix_map}")
        lockd_test_run(COMMAND ${settings})
        lockd_test_run(COMMAND "${CMAKE_COMMAND}" --build "${build}")
        lockd_test_run(COMMAND "${build}/check${suffix}")
        lockd_test_run(COMMAND "${build}/sdk_check${suffix}")
        file(GLOB_RECURSE objects "${build}/*.obj" "${build}/*.o")
        list(FILTER objects INCLUDE REGEX "[/\\\\](main|sdk_main|extra|constant_check)[.]cpp[.](o|obj)$")
        list(LENGTH objects count)
        lockd_test_equal("${count}" "4")
        set(timestamps "")
        foreach(object IN LISTS objects)
            file(TIMESTAMP "${object}" timestamp "%s.%f" UTC)
            list(APPEND timestamps "${timestamp}")
        endforeach ()
        lockd_test_run(COMMAND ${settings})
        lockd_test_run(COMMAND "${CMAKE_COMMAND}" --build "${build}")
        lockd_test_run(COMMAND "${build}/check${suffix}")
        lockd_test_run(COMMAND "${build}/sdk_check${suffix}")
        set(unchanged "")
        foreach(object IN LISTS objects)
            file(TIMESTAMP "${object}" timestamp "%s.%f" UTC)
            list(APPEND unchanged "${timestamp}")
        endforeach ()
        lockd_test_equal("${unchanged}" "${timestamps}")
    endforeach ()
endforeach ()

# The macro must require constant evaluation in both optimizer configurations.
# Change only the copied helper, then restore it before requiring compilation again.
set(header "${include}/liblockd/detail/source_path.hpp")
file(READ "${header}" original)
string(REPLACE "constexpr const char* relative_source_path("
        "const char* relative_source_path(" runtime "${original}")
if (runtime STREQUAL original)
    message(FATAL_ERROR "The helper mutation did not match the production declaration")
endif ()
foreach(configuration IN ITEMS Debug Release)
    lockd_test_run(COMMAND ${configure} "-DCMAKE_BUILD_TYPE=${configuration}" -DLOCKD_TEST_PREFIX_MAP=OFF)
    file(WRITE "${header}" "${runtime}")
    lockd_test_run(FAILS COMMAND "${CMAKE_COMMAND}" --build "${build}" --target constant_check)
    file(WRITE "${header}" "${original}")
    lockd_test_run(COMMAND "${CMAKE_COMMAND}" --build "${build}" --target constant_check)
endforeach ()
