cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/test_helpers.cmake")
lockd_test_prepare()
lockd_test_run(OUTPUT suffix COMMAND "${LOCKD_TEST_PYTHON}" -c
        "import sys; print(f'{sys.version_info.major}{sys.version_info.minor}')")
string(STRIP "${suffix}" suffix)

function(write_cache directory)
    file(MAKE_DIRECTORY "${directory}")
    set(contents "")
    foreach(key IN LISTS cache_keys)
        string(APPEND contents "${key}:STRING=${cache_${key}}\n")
    endforeach ()
    file(WRITE "${directory}/CMakeCache.txt" "${contents}")
endfunction()

function(require_argument array expected)
    string(JSON count LENGTH "${array}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON value GET "${array}" ${index})
        if (value STREQUAL expected)
            return()
        endif ()
    endforeach ()
    message(FATAL_ERROR "Missing frontend argument ${expected} in ${array}")
endfunction()

function(require_path actual expected)
    file(TO_CMAKE_PATH "${actual}" actual)
    file(TO_CMAKE_PATH "${expected}" expected)
    lockd_test_equal("${actual}" "${expected}")
endfunction()

function(run_package directory mode)
    set(settings "-DLOCKD_PACKAGE_BUILD_DIR=${directory}")
    if (NOT mode STREQUAL implicit)
        list(APPEND settings "-DLOCKD_PACKAGE_PYTHON=${LOCKD_TEST_PYTHON}")
    endif ()
    set(failure "")
    if (mode STREQUAL fail)
        set(failure FAILS)
    endif ()
    lockd_test_run(${failure} OUTPUT output COMMAND "${CMAKE_COMMAND}" -E env
            "LOCKD_HOST_BUILD_DIR=${native}" "WHEEL_TRACE=${trace_file}"
            "SDK_BUILD_TRACE=${builds}" "SDK_PREFIX=${sdk}" "CMAKE_GENERATOR=NMake Makefiles"
            "${CMAKE_COMMAND}" ${settings} -P "${root}/cmake/lockd_python_package.cmake")
    set(package_output "${output}" PARENT_SCOPE)
    if (NOT mode STREQUAL fail)
        file(READ "${trace_file}" frontend)
        set(frontend "${frontend}" PARENT_SCOPE)
    endif ()
endfunction()

foreach(case IN ITEMS default-venv explicit-python missing-sdk read-only static-profile toolchain mismatch)
    set(root "${LOCKD_TEST_WORK}/${case}")
    file(MAKE_DIRECTORY "${root}/cmake" "${root}/build" "${root}/scripts/release")
    foreach(name IN ITEMS lockd_python_package.cmake lockd_output_layout.cmake)
        configure_file("${LOCKD_TEST_SOURCE}/cmake/${name}" "${root}/cmake/${name}" COPYONLY)
    endforeach ()
    file(WRITE "${root}/build/__init__.py" "")
    # The external Python frontend records its invocation. Native selection assertions
    # stay in this CMake test; the fixture neither configures nor compiles native code.
    file(WRITE "${root}/build/__main__.py" [=[
import json
import os
import sys
from pathlib import Path
Path(os.environ['WHEEL_TRACE']).write_text(json.dumps({
    'executable': sys.executable, 'arguments': sys.argv[1:],
    'generator': os.environ.get('CMAKE_GENERATOR')}))
]=])
    set(builder [=[
param([string] $Python)
$ErrorActionPreference = 'Stop'
Add-Content -LiteralPath $env:SDK_BUILD_TRACE -Value $Python
foreach ($name in @('include/boost-1_88/boost/version.hpp',
        'lib/boost_python@suffix@-fixture.lib', 'lib/boost_python@suffix@-fixture.dll')) {
    $file = Join-Path $env:SDK_PREFIX $name
    New-Item -ItemType Directory -Force (Split-Path -Parent $file) | Out-Null
    Set-Content -LiteralPath $file -Value 'SDK fixture'
}
]=])
    string(CONFIGURE "${builder}" builder @ONLY)
    file(WRITE "${root}/scripts/release/build_boost_python.ps1" "${builder}")
    set(native "${root}/output/obj/x86_64/opt/shared")
    set(sdk "${native}/dependencies/release/boost_python${suffix}")
    set(native_python "${root}/native-sdk/boost_python${suffix}")
    set(trace_file "${root}/frontend.json")
    set(builds "${root}/sdk-builds.txt")
    set(cache_keys CMAKE_HOME_DIRECTORY CMAKE_GENERATOR CMAKE_MAKE_PROGRAM CMAKE_TOOLCHAIN_FILE
            CMAKE_C_COMPILER CMAKE_CXX_COMPILER LOCKD_TARGET_ARCH LOCKD_STATIC_RUNTIME
            Boost_INCLUDE_DIR "boost_python${suffix}_DIR")
    set(cache_CMAKE_HOME_DIRECTORY "${root}")
    set(cache_CMAKE_GENERATOR Ninja)
    set(cache_CMAKE_MAKE_PROGRAM "${root}/native-ninja.exe")
    set(cache_CMAKE_TOOLCHAIN_FILE "${root}/native-vcpkg.cmake")
    set(cache_CMAKE_C_COMPILER "${root}/native-cl.exe")
    set(cache_CMAKE_CXX_COMPILER "${root}/native-cl.exe")
    set(cache_LOCKD_TARGET_ARCH x86_64)
    set(cache_LOCKD_STATIC_RUNTIME OFF)
    set(cache_Boost_INCLUDE_DIR "${root}/native-boost/include")
    set(cache_boost_python${suffix}_DIR "${native_python}")

    if (case STREQUAL default-venv OR case STREQUAL explicit-python)
        lockd_test_run(COMMAND "${LOCKD_TEST_PYTHON}" -m venv --without-pip "${root}/.venv")
        write_cache("${native}")
        if (case STREQUAL default-venv)
            run_package("${native}" implicit)
            set(expected "${root}/.venv/Scripts/python.exe")
        else ()
            run_package("${native}" explicit)
            set(expected "${LOCKD_TEST_PYTHON}")
        endif ()
        string(JSON executable GET "${frontend}" executable)
        require_path("${executable}" "${expected}")
        if (case STREQUAL default-venv)
            file(STRINGS "${builds}" selected)
            require_path("${selected}" "${expected}")
        endif ()
    elseif (case STREQUAL missing-sdk)
        write_cache("${native}")
        set(previous "")
        foreach(attempt RANGE 1 2)
            run_package("${native}" explicit)
            string(JSON arguments GET "${frontend}" arguments)
            string(JSON generator GET "${frontend}" generator)
            lockd_test_equal("${generator}" Ninja)
            require_argument("${arguments}" "-Ccmake.define.Boost_ROOT=${sdk}")
            require_argument("${arguments}" -Ccmake.define.Boost_NO_BOOST_CMAKE=ON)
            require_argument("${arguments}" "-Ccmake.define.CMAKE_MAKE_PROGRAM=${cache_CMAKE_MAKE_PROGRAM}")
            lockd_test_absent("${arguments}" CMAKE_TOOLCHAIN_FILE=)
            lockd_test_absent("${arguments}" Boost_INCLUDE_DIR=)
            file(STRINGS "${builds}" selected)
            list(LENGTH selected count)
            lockd_test_equal("${count}" "1")
            require_path("${selected}" "${LOCKD_TEST_PYTHON}")
            if (attempt EQUAL 2)
                lockd_test_equal("${arguments}" "${previous}")
            endif ()
            set(previous "${arguments}")
        endforeach ()
    elseif (case STREQUAL read-only)
        file(MAKE_DIRECTORY "${native_python}")
        list(APPEND cache_keys VCPKG_MANIFEST_MODE)
        foreach(mode IN ITEMS ON OFF)
            set(cache_VCPKG_MANIFEST_MODE "${mode}")
            write_cache("${native}")
            run_package("${native}" explicit)
            string(JSON arguments GET "${frontend}" arguments)
            require_argument("${arguments}" -Ccmake.define.VCPKG_MANIFEST_INSTALL=OFF)
            require_argument("${arguments}" "-Ccmake.define.VCPKG_MANIFEST_MODE=${mode}")
            require_argument("${arguments}" "-Ccmake.define.CMAKE_TOOLCHAIN_FILE=${cache_CMAKE_TOOLCHAIN_FILE}")
            if (EXISTS "${builds}")
                message(FATAL_ERROR "The selected native SDK must remain read-only")
            endif ()
        endforeach ()
    elseif (case STREQUAL static-profile)
        file(MAKE_DIRECTORY "${native_python}")
        write_cache("${native}")
        set(cache_LOCKD_STATIC_RUNTIME ON)
        set(cache_CMAKE_GENERATOR "NMake Makefiles")
        write_cache("${native}/../static")
        run_package("${native}/../static" explicit)
        string(JSON generator GET "${frontend}" generator)
        lockd_test_equal("${generator}" Ninja)
        if (EXISTS "${builds}")
            message(FATAL_ERROR "Static wheel profiles must reuse the matching shared SDK")
        endif ()
    elseif (case STREQUAL toolchain)
        file(MAKE_DIRECTORY "${native_python}")
        foreach(setting IN ITEMS CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_TOOLCHAIN_FILE CMAKE_MAKE_PROGRAM)
            set(original "${cache_${setting}}")
            set(selected_builds "")
            foreach(attempt RANGE 0 2)
                if (attempt EQUAL 0)
                    set(cache_${setting} "${original}")
                else ()
                    set(cache_${setting} "${root}/other-${setting}")
                endif ()
                write_cache("${native}")
                run_package("${native}" explicit)
                string(JSON arguments GET "${frontend}" arguments)
                require_argument("${arguments}" "-Ccmake.define.${setting}=${cache_${setting}}")
                string(REGEX MATCH "-Cbuild-dir=[^\"]+" selected "${arguments}")
                if (selected STREQUAL "")
                    message(FATAL_ERROR "The frontend received no build directory")
                endif ()
                list(APPEND selected_builds "${selected}")
            endforeach ()
            list(GET selected_builds 0 first)
            list(GET selected_builds 1 changed)
            list(GET selected_builds 2 repeated)
            if (first STREQUAL changed)
                message(FATAL_ERROR "Changing ${setting} must isolate the wheel's CMake cache")
            endif ()
            lockd_test_equal("${repeated}" "${changed}")
            set(cache_${setting} "${original}")
            if (EXISTS "${builds}")
                message(FATAL_ERROR "Compiler selection must not rebuild the native Python SDK")
            endif ()
        endforeach ()
    else ()
        set(cache_LOCKD_TARGET_ARCH x86)
        write_cache("${native}")
        run_package("${native}" fail)
        lockd_test_contains("${package_output}" "Use a matching native profile")
        if (EXISTS "${builds}" OR EXISTS "${trace_file}")
            message(FATAL_ERROR "Architecture mismatches must fail before dependency/frontend calls")
        endif ()
    endif ()
endforeach ()
