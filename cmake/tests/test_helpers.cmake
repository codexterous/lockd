cmake_minimum_required(VERSION 3.24)

function(lockd_test_prepare)
    if (NOT IS_ABSOLUTE "${LOCKD_TEST_ROOT}" OR NOT IS_ABSOLUTE "${LOCKD_TEST_WORK}")
        message(FATAL_ERROR "Fixture root and work directories must be explicit absolute paths")
    endif ()
    cmake_path(NORMAL_PATH LOCKD_TEST_ROOT OUTPUT_VARIABLE root)
    cmake_path(NORMAL_PATH LOCKD_TEST_WORK OUTPUT_VARIABLE work)
    cmake_path(IS_PREFIX root "${work}" NORMALIZE contained)
    if (NOT contained OR work STREQUAL root)
        message(FATAL_ERROR "Fixture work directory must be beneath its configured root")
    endif ()
    file(REMOVE_RECURSE "${work}")
    file(MAKE_DIRECTORY "${work}")
endfunction()

# Keep fixture processes bounded and retain their actual diagnostics on failure.
function(lockd_test_run)
    cmake_parse_arguments(PARSE_ARGV 0 test "FAILS" "OUTPUT;DIRECTORY;RESULT;TIMEOUT" "COMMAND")
    if (NOT test_DIRECTORY)
        set(test_DIRECTORY "${LOCKD_TEST_WORK}")
    endif ()
    if (NOT test_TIMEOUT)
        set(test_TIMEOUT 120)
    endif ()
    execute_process(COMMAND ${test_COMMAND}
            WORKING_DIRECTORY "${test_DIRECTORY}" TIMEOUT "${test_TIMEOUT}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if (NOT status MATCHES "^[0-9]+$" OR (test_FAILS AND status STREQUAL "0") OR
            (NOT test_FAILS AND NOT status STREQUAL "0"))
        message(FATAL_ERROR "Unexpected result ${status} from ${test_COMMAND}\n${output}${error}")
    endif ()
    if (test_OUTPUT)
        set(${test_OUTPUT} "${output}${error}" PARENT_SCOPE)
    endif ()
    if (test_RESULT)
        set(${test_RESULT} "${status}" PARENT_SCOPE)
    endif ()
endfunction()

function(lockd_test_contains text expected)
    string(FIND "${text}" "${expected}" position)
    if (position EQUAL -1)
        message(FATAL_ERROR "Missing '${expected}' in:\n${text}")
    endif ()
endfunction()

function(lockd_test_equal actual expected)
    if (NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected '${expected}', received '${actual}'")
    endif ()
endfunction()

function(lockd_test_absent text unexpected)
    string(FIND "${text}" "${unexpected}" position)
    if (NOT position EQUAL -1)
        message(FATAL_ERROR "Unexpected '${unexpected}' in:\n${text}")
    endif ()
endfunction()
