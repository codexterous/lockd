cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/test_helpers.cmake")

function(find_workflow_step result required)
    set(index 0)
    foreach(step IN LISTS steps)
        string(FIND "${step}" "${required}" match)
        if (NOT match EQUAL -1)
            if (ARGC GREATER 2)
                string(FIND "${step}" "${ARGV2}" second)
                if (second EQUAL -1)
                    math(EXPR index "${index} + 1")
                    continue()
                endif ()
            endif ()
            set(${result} "${step}" PARENT_SCOPE)
            set(${result}_index "${index}" PARENT_SCOPE)
            return()
        endif ()
        math(EXPR index "${index} + 1")
    endforeach ()
    message(FATAL_ERROR "Missing workflow step containing ${required}")
endfunction()

# Every restored tool cache must have one guarded save, including after failed jobs.
file(GLOB_RECURSE workflows "${LOCKD_TEST_SOURCE}/.github/*.yml")
set(restores 0)
foreach(path IN LISTS workflows)
    file(READ "${path}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    lockd_test_absent("${text}" "uses: actions/cache@")
    string(REPLACE ";" "\\;" text "${text}")
    string(REGEX REPLACE "\n[ \t]*- name: " ";" steps "${text}")
    foreach(step IN LISTS steps)
        string(FIND "${step}" "uses: actions/cache/restore@" position)
        if (position EQUAL -1)
            continue()
        endif ()
        math(EXPR restores "${restores} + 1")
        string(REGEX MATCH "(^|\n)[ \t]+id: ([A-Za-z0-9_]+)\n" match "${step}")
        if (match STREQUAL "")
            message(FATAL_ERROR "Cache restore is missing an identity in ${path}")
        endif ()
        set(key "steps.${CMAKE_MATCH_2}.outputs.cache-primary-key")
        set(count 0)
        foreach(candidate IN LISTS steps)
            string(FIND "${candidate}" "uses: actions/cache/save@" action)
            string(FIND "${candidate}" "${key}" identity)
            if (action EQUAL -1 OR identity EQUAL -1)
                continue()
            endif ()
            math(EXPR count "${count} + 1")
            string(REGEX MATCH "(^|\n)[ \t]+if: ([^\n]+)" match "${candidate}")
            set(condition "${CMAKE_MATCH_2}")
            lockd_test_contains("${condition}" "always()")
            string(FIND "${condition}" "outcome" outcome)
            string(FIND "${condition}" "hashFiles(" hash)
            if (outcome EQUAL -1 AND hash EQUAL -1)
                message(FATAL_ERROR "Cache save must guard completed output in ${path}: ${key}")
            endif ()
        endforeach ()
        lockd_test_equal("${count}" "1")
    endforeach ()
endforeach ()
if (restores LESS 1)
    message(FATAL_ERROR "No dependency cache restore was checked")
endif ()

foreach(relative IN ITEMS .github/workflows/release_windows.yml .github/actions/windows_analysis/action.yml)
    file(READ "${LOCKD_TEST_SOURCE}/${relative}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(REPLACE ";" "\\;" text "${text}")
    string(REGEX REPLACE "\n[ \t]*- name: " ";" steps "${text}")
    find_workflow_step(restored "id: native_cache\n")
    find_workflow_step(baseline "id: native_cache_state\n")
    find_workflow_step(collected "id: collect_native\n")
    find_workflow_step(saved "uses: actions/cache/save@" "steps.native_cache.outputs.cache-primary-key")
    string(REGEX MATCH "(^|\n)[ \t]+key: ([^\n]+)" found "${restored}")
    set(key "${CMAKE_MATCH_2}")
    lockd_test_contains("${key}" github.run_id)
    lockd_test_contains("${key}" github.run_attempt)
    lockd_test_contains("${restored}" "restore-keys: |")
    lockd_test_contains("${restored}" native-windows-v2-)
    string(FIND "${text}" "id: toolchain\n" toolchain_position)
    if (toolchain_position EQUAL -1)
        find_workflow_step(toolchain "id: native_toolchain\n")
    else ()
        find_workflow_step(toolchain "id: toolchain\n")
    endif ()
    string(REGEX MATCH "(^|\n)[ \t]+\\$identity = ([^\n]+)" found "${toolchain}")
    set(identity "${CMAKE_MATCH_2}")
    foreach(value IN ITEMS "$cmakeVersion" "$powerShellVersion" "$env:ImageVersion")
        lockd_test_contains("${identity}" "${value}")
    endforeach ()
    if (NOT baseline_index LESS collected_index)
        message(FATAL_ERROR "The baseline must precede native cache collection in ${relative}")
    endif ()
    set(digest "hashFiles('output/obj/*/opt/shared/cache/native/**')")
    lockd_test_contains("${baseline}" "digest=\${{ ${digest} }}")
    string(REGEX MATCH "(^|\n)[ \t]+if: ([^\n]+)" found "${collected}")
    set(condition "${CMAKE_MATCH_2}")
    lockd_test_contains("${condition}" "always()")
    lockd_test_absent("${condition}" cache-hit)
    string(REGEX MATCH "(^|\n)[ \t]+if: ([^\n]+)" found "${saved}")
    set(condition "${CMAKE_MATCH_2}")
    lockd_test_contains("${condition}" "always()")
    lockd_test_contains("${condition}" "steps.collect_native.outcome == 'success'")
    lockd_test_contains("${condition}" "${digest} != steps.native_cache_state.outputs.digest")
endforeach ()
