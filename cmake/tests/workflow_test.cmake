# Exercise the actual GitHub expression over the same event/result/cancellation matrix.
# Its supported operators map directly to CMake's boolean expression operators.
foreach(event IN ITEMS workflow_dispatch push)
    foreach(ref IN ITEMS refs/heads/main refs/tags/v1.0.1)
        foreach(result IN ITEMS success failure skipped)
            foreach(cancelled IN ITEMS TRUE FALSE)
                set(expression "${publication_condition}")
                if (cancelled)
                    set(active FALSE)
                else ()
                    set(active TRUE)
                endif ()
                if (ref MATCHES "^refs/tags/v")
                    set(tag TRUE)
                else ()
                    set(tag FALSE)
                endif ()
                string(REPLACE "!cancelled()" "${active}" expression "${expression}")
                string(REPLACE "startsWith(github.ref, 'refs/tags/v')" "${tag}" expression "${expression}")
                string(REPLACE "github.event_name" "'${event}'" expression "${expression}")
                foreach(name IN ITEMS assemble sign_windows)
                    string(REPLACE "needs.${name}.result" "'${result}'" expression "${expression}")
                endforeach ()
                string(REPLACE "'" "\"" expression "${expression}")
                string(REPLACE "==" " STREQUAL " expression "${expression}")
                string(REPLACE "&&" " AND " expression "${expression}")
                string(REPLACE "||" " OR " expression "${expression}")
                string(REPLACE "(" " ( " expression "${expression}")
                string(REPLACE ")" " ) " expression "${expression}")
                separate_arguments(tokens UNIX_COMMAND "${expression}")
                set(actual FALSE)
                if (${tokens})
                    set(actual TRUE)
                endif ()
                set(expected FALSE)
                if ((event STREQUAL workflow_dispatch OR tag) AND result STREQUAL success AND active)
                    set(expected TRUE)
                endif ()
                lockd_test_equal("${actual}" "${expected}")
            endforeach ()
        endforeach ()
    endforeach ()
endforeach ()
