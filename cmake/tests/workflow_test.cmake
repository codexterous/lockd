set(groups "wheels_linux|Python - Linux|release_python|wheels"
        "wheels_windows|Python - Windows|release_python_windows|wheels"
        "windows|Compatibility Testing - Windows|release_windows|tests"
        "linux|Compatibility Testing - Linux|compatibility_linux|tests"
        "freebsd|Compatibility Testing - FreeBSD|freebsd|tests"
        "windows_services|Service Testing - Windows|windows_services|tests")
foreach(caller IN ITEMS compatibility release)
    foreach(group IN LISTS groups)
        string(REPLACE "|" ";" fields "${group}")
        list(GET fields 0 job)
        list(GET fields 1 heading)
        list(GET fields 2 worker)
        list(GET fields 3 matrix_job)
        lockd_test_contains("${block_${caller}_${job}}" "    name: ${heading}\n")
        lockd_test_contains("${block_${caller}_${job}}" "    uses: ./.github/workflows/${worker}.yml\n")
        require_set("${jobs_${worker}}" "${matrix_job}")
        lockd_test_contains("${block_${worker}_${matrix_job}}" "    strategy:\n")
    endforeach ()
    foreach(platform IN ITEMS Linux Windows)
        string(TOLOWER "${platform}" lower)
        set(worker "clang_tidy_${lower}")
        list(LENGTH jobs_${worker} count)
        lockd_test_equal("${count}" "1")
        list(GET jobs_${worker} 0 job)
        lockd_test_contains("${block_${worker}_${job}}" "    name: ${platform}\n")
        lockd_test_contains("${block_${caller}_analysis_${lower}}" "    name: clang-tidy\n")
        lockd_test_contains("${block_${caller}_analysis_${lower}}"
                "    uses: ./.github/workflows/${worker}.yml\n")
    endforeach ()
    require_set("${parents_${caller}_windows_services}" "source;windows")
    list(FIND jobs_${caller} windows native_index)
    list(FIND jobs_${caller} windows_services service_index)
    list(FIND jobs_${caller} linux linux_index)
    math(EXPR following "${service_index} + 1")
    if (NOT native_index LESS service_index OR NOT following EQUAL linux_index)
        message(FATAL_ERROR "Service checks must follow Windows and precede Linux in ${caller}")
    endif ()
    ancestors("${caller}" wheels_linux parents)
    require_set("${parents}" source)
    ancestors("${caller}" linux parents)
    require_set("${parents}" "source;wheels_linux")
    ancestors("${caller}" wheels_windows parents)
    require_set("${parents}" "source;windows")
    set(gate tested_python)
    if (caller STREQUAL release)
        set(gate assemble)
    endif ()
    ancestors("${caller}" "${gate}" parents)
    foreach(required IN ITEMS wheels_linux wheels_windows)
        if (NOT required IN_LIST parents)
            message(FATAL_ERROR "${caller}/${gate} must require ${required}")
        endif ()
    endforeach ()
    foreach(job IN ITEMS analysis_linux analysis_windows windows wheels_linux)
        require_set("${parents_${caller}_${job}}" source)
    endforeach ()
    foreach(job IN LISTS jobs_${caller})
        if (job STREQUAL assemble OR job STREQUAL tested_python)
            continue()
        endif ()
        foreach(analysis IN ITEMS analysis_linux analysis_windows)
            if (analysis IN_LIST parents_${caller}_${job})
                message(FATAL_ERROR "Analysis must not serialize ${caller}/${job}")
            endif ()
        endforeach ()
    endforeach ()
    foreach(analysis IN ITEMS analysis_linux analysis_windows)
        lockd_test_absent("${block_${caller}_${analysis}}" "continue-on-error:")
        if (caller STREQUAL release AND NOT analysis IN_LIST parents_release_assemble)
            message(FATAL_ERROR "Assembly must require ${analysis}")
        endif ()
    endforeach ()
    set(required "${jobs_compatibility}")
    list(REMOVE_ITEM required tested_python)
    require_set("${parents_${caller}_tested_python}" "${required}")
    string(REGEX MATCHALL "\n    if: [^\n]+" conditions "${block_${caller}_tested_python}")
    if (caller STREQUAL compatibility)
        lockd_test_equal("${conditions}" "\n    if: success() && inputs.source_version == ''")
    else ()
        lockd_test_equal("${conditions}" "")
    endif ()
endforeach ()
