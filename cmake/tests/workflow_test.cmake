cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/test_helpers.cmake")

# Read the repository's two-space job blocks without interpreting their step scripts.
file(GLOB workflows "${LOCKD_TEST_SOURCE}/.github/workflows/*.yml")
foreach(path IN LISTS workflows)
    get_filename_component(filename "${path}" NAME_WE)
    file(STRINGS "${path}" lines ENCODING UTF-8)
    set(job "")
    set(in_jobs FALSE)
    set(jobs_${filename} "")
    foreach(line IN LISTS lines)
        if (line STREQUAL "jobs:")
            set(in_jobs TRUE)
        endif ()
        if (NOT in_jobs)
            continue()
        endif ()
        if (line MATCHES "^  ([A-Za-z0-9_]+):$")
            set(job "${CMAKE_MATCH_1}")
            list(APPEND jobs_${filename} "${job}")
            set(block_${filename}_${job} "")
        elseif (NOT job STREQUAL "")
            string(APPEND block_${filename}_${job} "${line}\n")
        endif ()
    endforeach ()
    foreach(job IN LISTS jobs_${filename})
        set(parents_${filename}_${job} "")
        if (block_${filename}_${job} MATCHES "(^|\n)    needs: ([^\n]+)")
            string(REGEX REPLACE "[][ ]" "" parents "${CMAKE_MATCH_2}")
            string(REPLACE "," ";" parents_${filename}_${job} "${parents}")
        endif ()
    endforeach ()
endforeach ()

function(require_set actual expected)
    list(SORT actual)
    list(SORT expected)
    lockd_test_equal("${actual}" "${expected}")
endfunction()

function(require_before text first second)
    string(FIND "${text}" "${first}" start)
    string(FIND "${text}" "${second}" end)
    if (start LESS 0 OR end LESS 0 OR NOT start LESS end)
        message(FATAL_ERROR "Expected ${first} before ${second}")
    endif ()
endfunction()

function(ancestors filename job result)
    set(parents "${parents_${filename}_${job}}")
    set(found "${parents}")
    foreach(parent IN LISTS parents)
        ancestors("${filename}" "${parent}" previous)
        list(APPEND found ${previous})
    endforeach ()
    list(REMOVE_DUPLICATES found)
    set(${result} "${found}" PARENT_SCOPE)
endfunction()

function(condition block result)
    if (NOT block MATCHES "    if: >-\n([^;]+)    runs-on:")
        message(FATAL_ERROR "Missing multiline publication condition")
    endif ()
    string(REGEX REPLACE "[ \t\r\n]+" " " value "${CMAKE_MATCH_1}")
    string(STRIP "${value}" value)
    set(${result} "${value}" PARENT_SCOPE)
endfunction()

